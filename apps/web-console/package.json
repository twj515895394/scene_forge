{
  "name": "@scene-forge/web-console",
  "version": "1.0.0",
  "description": "SceneForge Web UI and PTY backend",
  "main": "dist/server/server.js",
  "scripts": {
    "dev:server": "tsx --watch server/server.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "tsc -p tsconfig.server.json && node --test \"dist/server/tests/**/*.test.js\"",
    "dev": "bash dev.sh"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@scene-forge/engine": "workspace:*",
    "autoprefixer": "^10.5.0",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0-beta21",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "playwright": "^1.60.0",
    "tsx": "^4.11.0",
    "vite": "^5.2.11"
